{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arkoto",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arkoto",
      "database_id": "7ced5571-be44-48de-800b-8096749f24a6"
    }
  ]
}
